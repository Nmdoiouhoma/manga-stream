# Frontend env vars. Copy to `.env.local` and adjust.
# (Only vars prefixed with VITE_ are exposed to the browser bundle — never put secrets here.)

# Base URL of the API Platform backend.
# The contract declares `servers: [{ url: "/" }]`, so the base URL is the front's job.
# Leave empty to call the same origin — which is what MSW intercepts in dev.
# Against the real backend: VITE_API_URL=http://localhost:8000/api
# (a trailing `/api` is stripped automatically — see src/api/baseUrl.ts)
VITE_API_URL=

# "true"  -> MSW intercepts /api and serves the mock dataset (default in dev)
# "false" -> requests hit the real backend at VITE_API_URL
# Ignored in production builds: MSW is never bundled there.
VITE_USE_MOCKS=true

# Mercure hub, for real-time notifications (SSE).
# Empty disables the subscription entirely: the bell then refreshes on demand,
# which is a supported mode, not a failure.
VITE_MERCURE_URL=http://localhost:3000/.well-known/mercure

# Optional. Comma-separated Mercure topics; {origin}, {userIri} and {userId}
# are substituted at runtime. Leave unset to use the defaults in src/config.ts.
VITE_MERCURE_TOPICS=
