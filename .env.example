# ===========================================================================
# manga-stream :: environment template
#
#   cp .env.example .env
#   docker compose up -d
#
# This file is read by Docker Compose (root .env) and holds the DEV defaults.
# Never commit a real .env — it is gitignored.
# ===========================================================================

# ---------------------------------------------------------------------------
# Host uid/gid used to build the backend image so that bind-mounted files
# stay writable. On Linux run: `echo "UID=$(id -u)\nGID=$(id -g)" >> .env`.
# On macOS (Docker Desktop) the defaults are fine.
# ---------------------------------------------------------------------------
UID=1000
GID=1000

# ---------------------------------------------------------------------------
# Published host ports (change if something already listens there)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
MERCURE_PORT=3000
POSTGRES_PORT=5432
# Mailpit : 8025 = interface web (lecture des mails), 1025 = SMTP.
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---------------------------------------------------------------------------
# Réseau Docker
#
# La plage est figée au lieu d'être choisie par Docker : c'est elle que le
# backend déclare en proxys de confiance, et une valeur qui change d'un poste
# à l'autre ne se documente pas.
#
# À ne changer QUE si la plage entre en collision avec un autre réseau Docker
# de la machine (« Pool overlaps with other one on this address space ») :
# changer les deux valeurs de façon cohérente, puis
# `docker compose down && docker compose up -d`. Les volumes — donc la base —
# survivent.
# ---------------------------------------------------------------------------
DOCKER_SUBNET=172.21.0.0/16
# IP fixe de nginx. Fixe parce que php-fpm ne voit que l'IP de nginx : c'est
# l'adresse que Symfony doit reconnaître comme proxy de confiance pour accepter
# de lire l'IP réelle du visiteur dans X-Forwarded-For.
NGINX_IP=172.21.0.250

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=manga_stream
POSTGRES_USER=manga
POSTGRES_PASSWORD=manga

# Consumed by Symfony/Doctrine. INSIDE Docker the host is `database`
# (the compose service name). From the host machine, use `localhost:5432`.
DATABASE_URL="postgresql://manga:manga@database:5432/manga_stream?serverVersion=16&charset=utf8"

# ---------------------------------------------------------------------------
# Symfony
# ---------------------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
# Regenerate for any real deployment: `openssl rand -hex 32`
APP_SECRET=e9b6048cc82b6e2cd936a2d8a382766a

# CORS (nelmio/cors-bundle). Regex matching the allowed browser origins.
# `$` must NOT be escaped here — the escaping only applies inside compose files.
# Covers the Vite dev server on localhost:5173. Widen it if you ever expose the
# frontend on another host or port.
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Base URL used by Symfony to build absolute URLs outside of an HTTP request
# (CLI commands, mailer, Mercure Link headers). Must match the nginx vhost.
DEFAULT_URI=http://localhost:8000

# ---------------------------------------------------------------------------
# Proxys de confiance
#
# Lu automatiquement par Symfony : la valeur par défaut de
# framework.trusted_proxies est `%env(default::SYMFONY_TRUSTED_PROXIES)%`.
# Il n'y a donc RIEN à ajouter dans backend/config/packages/framework.yaml,
# la variable suffit.
#
# Le problème qu'elle résout : en FastCGI, REMOTE_ADDR est l'adresse de celui
# qui a ouvert la connexion vers nginx. En dev (un seul saut) c'est bien le
# visiteur ; en production nginx est derrière Caddy et REMOTE_ADDR vaut l'IP
# du conteneur Caddy, la MÊME pour tout le monde. Un limiteur de débit indexé
# sur l'IP compterait alors tout le trafic sur une seule clé — le premier
# attaquant sur /api/login bloquerait la connexion de tout le monde. La seule
# information restante sur le visiteur est la chaîne X-Forwarded-For, que
# Symfony n'accepte de lire que si REMOTE_ADDR est dans cette liste.
#
# Une seule adresse ici, pas la plage. Sur Linux, les requêtes venues de
# l'hôte arrivent avec l'adresse de la passerelle Docker (172.21.0.1), qui
# appartient à 172.21.0.0/16 : déclarer la plage de confiance rendrait
# l'usurpation par X-Forwarded-For possible depuis le poste. Sous Docker
# Desktop (macOS) elles arrivent de 192.168.65.1, hors plage — le défaut ne
# se verrait donc pas ici, ce qui est précisément le danger.
#
# Vérification, en-tête forgé à la main :
#   curl -s -H 'X-Forwarded-For: 6.6.6.6' http://localhost:8000/api
#   -> l'application doit voir votre IP réelle, jamais 6.6.6.6.
#
# En production, nginx est lui-même derrière Caddy : les deux sauts sont
# internes au réseau Docker et la valeur devient la plage complète
# (voir docker-compose.prod.yml et la section « Déploiement » du README).
# ---------------------------------------------------------------------------
SYMFONY_TRUSTED_PROXIES=172.21.0.250

# ---------------------------------------------------------------------------
# Envoi d'e-mails (symfony/mailer)
#
# En dev, tout part dans Mailpit : rien ne sort de la machine, aucun vrai
# destinataire ne reçoit quoi que ce soit. Les mails se lisent sur
# http://localhost:8025
#
# `mailpit` est le nom du service compose. Depuis le conteneur backend,
# `localhost` désignerait le conteneur backend lui-même — erreur classique.
#
# Le worker reçoit le MÊME DSN : c'est lui qui expédie réellement dès que le
# mail est routé en asynchrone via Messenger.
#
# Production : remplacer par le DSN du vrai relais, par ex.
#   MAILER_DSN=smtp://utilisateur:motdepasse@smtp.exemple.net:587
#   MAILER_DSN=brevo+api://CLE@default
# et ne jamais committer ce fichier-là.
# ---------------------------------------------------------------------------
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=no-reply@manga-stream.local
# Nombre de mails conservés par Mailpit (anneau glissant).
MAILPIT_MAX_MESSAGES=500

# Set to 1 to run `doctrine:migrations:migrate` automatically when the backend
# container starts. Left at 0 by default so a `docker compose up` never mutates
# a schema behind your back — run it explicitly, see README.md.
RUN_MIGRATIONS=0

# ---------------------------------------------------------------------------
# JWT authentication (lexik/jwt-authentication-bundle)
#
# The bundle signs its tokens with an RSA keypair stored in
# backend/config/jwt/. Those two files are SECRETS: they are gitignored and
# must never be committed (this repository is public — a leaked private.pem
# lets anyone forge a token for any user).
#
# You have nothing to do: infra/backend/docker-entrypoint.sh generates the
# pair on the first `docker compose up` when it is missing. To regenerate it
# by hand, see the "JWT" section of README.md.
#
# The values below are the paths Symfony resolves at runtime
# (%kernel.project_dir% = /var/www/html inside the container), NOT the keys.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Dev passphrase protecting private.pem. Obvious on purpose: change it for any
# deployment that is not your laptop.
JWT_PASSPHRASE=manga_stream_dev_passphrase
# Access-token lifetime in seconds (1h).
JWT_TTL=3600
# Set to 0 to stop the entrypoint from generating the keypair (e.g. when you
# mount your own keys into the container).
GENERATE_JWT_KEYS=1

# ---------------------------------------------------------------------------
# Messenger (asynchronous jobs) — service `worker`
#
# The queue lives in PostgreSQL, in the `messenger_messages` table.
# `auto_setup=0` means that table comes from a Doctrine migration rather than
# from an implicit CREATE TABLE: schema changes stay explicit and reviewable.
# ---------------------------------------------------------------------------
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Transport(s) consumed by the worker (space separated for several).
MESSENGER_CONSUME_TRANSPORTS=async
# The consumer stops by itself after this many seconds, then the entrypoint
# restarts it. This is the standard remedy against long-running PHP leaks.
MESSENGER_TIME_LIMIT=3600
# ... and it also stops if the PHP process exceeds this memory footprint.
MESSENGER_MEMORY_LIMIT=128M
# Delay before retrying when the transport is not consumable yet (transport
# not configured, table not migrated, database restarting...).
MESSENGER_RETRY_DELAY=15

# ---------------------------------------------------------------------------
# Mercure (real-time SSE hub)
#
#   MERCURE_URL        server-side publish endpoint (container -> container)
#   MERCURE_PUBLIC_URL endpoint advertised to browsers (host -> container)
#   MERCURE_JWT_SECRET shared HS256 secret for publisher AND subscriber
# ---------------------------------------------------------------------------
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# Origins allowed to subscribe / publish through the hub (space separated).
# The browser sends the mercureAuthorization cookie with `withCredentials`, so
# these must be exact origins: a credentialed request against "*" is rejected
# by the browser itself.
MERCURE_CORS_ORIGINS=http://localhost:5173 http://127.0.0.1:5173 http://localhost:8000
MERCURE_PUBLISH_ORIGINS=http://localhost:5173 http://localhost:8000 http://localhost:3000

# --- Anonymous subscriptions -----------------------------------------------
# false (default) : every subscriber must present a JWT whose
#                   `mercure.subscribe` claim lists the topics it may read.
#                   The backend mints that token for the logged-in user, the
#                   browser sends it in the `mercureAuthorization` cookie.
# true            : ANY browser can subscribe to ANY topic, including
#                   /api/users/<someone else>/notifications. That is a data
#                   leak the moment per-user payloads are published.
#
# Only flip it to true to unblock local work while the backend endpoint that
# issues subscriber tokens is not merged. A better unblock, which keeps the
# hub closed, is to mint yourself a token:
#
#   infra/mercure/mint-jwt.sh subscribe /api/users/1/notifications
#
# Verify the whole thing at any time with:
#
#   infra/mercure/check-authorization.sh
MERCURE_ALLOW_ANONYMOUS=false

# Mercure debug console on /.well-known/mercure/ui/. It cannot bypass
# authorization but it is one more unauthenticated page: off by default.
MERCURE_DEMO_UI=false

# Subscription API (/.well-known/mercure/subscriptions). Keep it on: the hub
# uses it to expose who is connected.
MERCURE_SUBSCRIPTIONS=true

# ---------------------------------------------------------------------------
# Frontend (Vite)
# Only VITE_* prefixed variables reach the browser bundle. They are inlined at
# BUILD time, so changing them requires restarting the dev server.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_MERCURE_URL=http://localhost:3000/.well-known/mercure
# Topics souscrits par le navigateur, séparés par des virgules. Laissez vide :
# le frontend utilise alors ses propres valeurs par défaut
# (voir frontend/src/config.ts). À renseigner le jour où le backend fige sa
# convention de publication.
VITE_MERCURE_TOPICS=
# `true` -> the frontend serves fixtures instead of calling the API,
# which lets the UI progress while the backend endpoints are still missing.
VITE_USE_MOCKS=false

# Escape hatch for a peer-dependency conflict in frontend/package.json.
# Leave EMPTY. Set to --legacy-peer-deps only to temporarily unblock a build;
# the real fix belongs in package.json.
NPM_INSTALL_FLAGS=

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------
ANILIST_API_URL=https://graphql.anilist.co
