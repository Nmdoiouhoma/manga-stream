# ===========================================================================
# manga-stream :: environment template
#
#   cp .env.example .env
#   docker compose up -d
#
# This file is read by Docker Compose (root .env) and holds the DEV defaults.
# Never commit a real .env — it is gitignored.
# ===========================================================================

# ---------------------------------------------------------------------------
# Host uid/gid used to build the backend image so that bind-mounted files
# stay writable. On Linux run: `echo "UID=$(id -u)\nGID=$(id -g)" >> .env`.
# On macOS (Docker Desktop) the defaults are fine.
# ---------------------------------------------------------------------------
UID=1000
GID=1000

# ---------------------------------------------------------------------------
# Published host ports (change if something already listens there)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
MERCURE_PORT=3000
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=manga_stream
POSTGRES_USER=manga
POSTGRES_PASSWORD=manga

# Consumed by Symfony/Doctrine. INSIDE Docker the host is `database`
# (the compose service name). From the host machine, use `localhost:5432`.
DATABASE_URL="postgresql://manga:manga@database:5432/manga_stream?serverVersion=16&charset=utf8"

# ---------------------------------------------------------------------------
# Symfony
# ---------------------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
# Regenerate for any real deployment: `openssl rand -hex 32`
APP_SECRET=e9b6048cc82b6e2cd936a2d8a382766a

# CORS (nelmio/cors-bundle). Regex matching the allowed browser origins.
# `$` must NOT be escaped here — the escaping only applies inside compose files.
# Covers the Vite dev server on localhost:5173. Widen it if you ever expose the
# frontend on another host or port.
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Base URL used by Symfony to build absolute URLs outside of an HTTP request
# (CLI commands, mailer, Mercure Link headers). Must match the nginx vhost.
DEFAULT_URI=http://localhost:8000

# Set to 1 to run `doctrine:migrations:migrate` automatically when the backend
# container starts. Left at 0 by default so a `docker compose up` never mutates
# a schema behind your back — run it explicitly, see README.md.
RUN_MIGRATIONS=0

# ---------------------------------------------------------------------------
# JWT authentication (lexik/jwt-authentication-bundle)
# Generate the keypair once, inside the backend container:
#   docker compose exec backend php bin/console lexik:jwt:generate-keypair
# The keys land in backend/config/jwt/ and are gitignored.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=manga_stream_dev_passphrase
# Token lifetime in seconds (1h).
JWT_TTL=3600

# ---------------------------------------------------------------------------
# Mercure (real-time SSE hub)
#
#   MERCURE_URL        server-side publish endpoint (container -> container)
#   MERCURE_PUBLIC_URL endpoint advertised to browsers (host -> container)
#   MERCURE_JWT_SECRET shared HS256 secret for publisher AND subscriber
# ---------------------------------------------------------------------------
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# Origins allowed to subscribe / publish through the hub (space separated).
MERCURE_CORS_ORIGINS=http://localhost:5173 http://127.0.0.1:5173 http://localhost:8000
MERCURE_PUBLISH_ORIGINS=http://localhost:5173 http://localhost:8000 http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Vite)
# Only VITE_* prefixed variables reach the browser bundle. They are inlined at
# BUILD time, so changing them requires restarting the dev server.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_MERCURE_URL=http://localhost:3000/.well-known/mercure
# `true` -> the frontend serves fixtures instead of calling the API,
# which lets the UI progress while the backend endpoints are still missing.
VITE_USE_MOCKS=false

# Escape hatch for a peer-dependency conflict in frontend/package.json.
# Leave EMPTY. Set to --legacy-peer-deps only to temporarily unblock a build;
# the real fix belongs in package.json.
NPM_INSTALL_FLAGS=

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------
ANILIST_API_URL=https://graphql.anilist.co
