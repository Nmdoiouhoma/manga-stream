# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://manga:manga@database:5432/manga_stream?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
# File Messenger. `doctrine://default` = table `messenger_messages` de la base
# principale ; `auto_setup=0` car la table est créée par une migration.
# Traitement : php bin/console messenger:consume async
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
# Les clés RSA vivent dans config/jwt/ et sont GITIGNORÉES : ce dépôt est public,
# aucune clé ne doit y entrer. Génération : php bin/console lexik:jwt:generate-keypair
# (le conteneur backend s'en charge tout seul au démarrage).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Passphrase de DÉVELOPPEMENT, alignée sur docker-compose.yml et .env.example.
# Elle ne protège qu'une clé locale jetable ; en production, la surcharger via
# l'environnement (elle n'a de valeur que combinée à la clé privée, elle-même
# jamais versionnée).
JWT_PASSPHRASE=manga_stream_dev_passphrase
# Durée de validité du jeton, en secondes.
JWT_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> symfony/mercure-bundle ###
# Valeurs alignées sur docker-compose.yml : conteneur -> conteneur pour publier,
# URL publique pour l'abonnement depuis le navigateur.
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# Secret HS256 partagé avec le hub. Ce n'est PAS un secret : c'est le placeholder de
# développement déjà présent dans docker-compose.yml, identique pour tout le monde.
# En production il DOIT être surchargé par l'environnement — sans quoi n'importe qui
# peut publier sur le hub. Dépôt public : ne jamais y écrire la vraie valeur.
#
# Cette même clé signe les JWT ABONNÉS remis au navigateur
# (App\Service\Notification\MercureSubscriptionFactory). Elle doit faire au moins
# 32 octets : HS256 refuse de signer en dessous de 256 bits.
#
# Il n'y a volontairement AUCUN interrupteur « publier en privé » : toutes les mises à
# jour partent en `private`, sans exception. Un tel réglage, à 0 par défaut, aurait été
# un piège — une update publique reste diffusée à TOUS les abonnés du topic, quelles
# que soient les restrictions posées sur les abonnements.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> symfony/mailer ###
# Transport SMTP. En développement, le service `mailpit` de docker-compose.yml :
# rien ne sort de la machine et tous les messages s'affichent sur
# http://localhost:8025. `mailpit` est le nom du service compose, PAS localhost —
# depuis le conteneur backend, localhost désigne le conteneur backend lui-même.
#
# `null://null` reste le défaut hors Docker (et en test) : un envoi qui échoue
# silencieusement vaut mieux qu'une suite de tests qui ouvre des sockets SMTP.
MAILER_DSN=null://null
# Expéditeur des messages transactionnels.
MAILER_FROM=no-reply@manga-stream.local
###< symfony/mailer ###

###> app ###
# Base des liens envoyés par e-mail. C'est le FRONTEND qui sert /password/reset,
# pas l'API : pointer sur l'API donnerait un lien mort. En dev, nginx sert les
# deux sur le port 8000.
FRONTEND_BASE_URL=http://localhost:8000
###< app ###
