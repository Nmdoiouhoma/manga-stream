# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Symfony ne charge pas .env.local en environnement de test : sans cette ligne, les
# tests lancés hors Docker viseraient l'hôte `database` hérité de .env, injoignable
# depuis la machine. Doctrine ajoute lui-même le suffixe `_test` (voir `when@test`
# dans config/packages/doctrine.yaml) : la base réellement utilisée est
# `manga_stream_test`. La CI et l'exécution en conteneur surchargent DATABASE_URL par
# l'environnement, qui a la priorité sur ce fichier.
DATABASE_URL="postgresql://manga:manga@127.0.0.1:5432/manga_stream?serverVersion=16&charset=utf8"
