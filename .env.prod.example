# ===========================================================================
# manga-stream :: modèle d'environnement de PRODUCTION
#
#   scp .env.prod.example utilisateur@vps:/srv/manga-stream/.env
#   ssh utilisateur@vps
#   cd /srv/manga-stream && vi .env      # puis générer les secrets, voir plus bas
#   chmod 600 .env
#
# Le fichier réel s'appelle `.env` sur le serveur (compose ne lit que ce nom).
# Il est gitignoré. CE DÉPÔT EST PUBLIC : aucune valeur ci-dessous n'est un
# secret utilisable, ce sont des emplacements à remplir.
#
# ---------------------------------------------------------------------------
# LES SECRETS SE GÉNÈRENT SUR LE SERVEUR, UNE FOIS, ET N'EN SORTENT PAS
#
# Reprendre une valeur du dépôt reviendrait à publier la clé : n'importe qui
# pourrait forger un jeton d'authentification pour n'importe quel compte
# (APP_SECRET, JWT) ou publier de fausses notifications (MERCURE_JWT_SECRET).
#
#   openssl rand -hex 32     # APP_SECRET
#   openssl rand -hex 32     # MERCURE_JWT_SECRET
#   openssl rand -hex 32     # JWT_PASSPHRASE
#   openssl rand -hex 24     # POSTGRES_PASSWORD
#
# La paire RSA de lexik/jwt-authentication-bundle est générée automatiquement
# au premier démarrage par infra/backend/docker-entrypoint.sh, à partir de la
# JWT_PASSPHRASE ci-dessous. Elle vit dans backend/config/jwt/, qui est
# gitignoré. NE PAS la copier depuis un poste de développement.
#
# Sauvegarder ce .env et backend/config/jwt/ hors du serveur, chiffrés :
# perdre JWT_PASSPHRASE ou private.pem déconnecte tout le monde (les jetons
# émis deviennent invérifiables), perdre APP_SECRET invalide les sessions.
# ===========================================================================

# ---------------------------------------------------------------------------
# Domaine public
# ---------------------------------------------------------------------------
# Doit déjà pointer sur l'IP du VPS (enregistrement A, et AAAA si IPv6) AVANT
# le premier démarrage : Caddy demande son certificat immédiatement et
# Let's Encrypt plafonne à 5 échecs par heure.
PUBLIC_DOMAIN=exemple.tld
# Adresse de contact Let's Encrypt : c'est là qu'arrivent les alertes si un
# renouvellement échoue. Une adresse réellement relevée, pas un alias oublié.
ACME_EMAIL=admin@exemple.tld

# ---------------------------------------------------------------------------
# Exposition réseau
# ---------------------------------------------------------------------------
# 127.0.0.1 : les ports publiés (5432, 8000, 3000, 5173) ne sont accessibles
# que depuis le serveur lui-même. Seul Caddy écoute sur l'IP publique.
# Mettre 0.0.0.0 ici ouvrirait PostgreSQL sur Internet.
BIND_IP=127.0.0.1

# En production le conteneur frontend sert du statique sur le port 80, pas le
# serveur de dev Vite sur 5173.
FRONTEND_CONTAINER_PORT=80

# Plage du réseau Docker. À changer seulement en cas de collision avec un
# autre réseau du serveur.
DOCKER_SUBNET=172.21.0.0/16
NGINX_IP=172.21.0.250

# Proxys de confiance : la plage COMPLÈTE ici, contrairement au dev.
# Deux sauts internes séparent le visiteur de l'application (Caddy puis
# nginx) et l'adresse de Caddy est allouée dynamiquement. C'est sûr parce
# qu'aucun visiteur ne peut émettre depuis l'intérieur du réseau Docker.
SYMFONY_TRUSTED_PROXIES=172.21.0.0/16

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=manga_stream
POSTGRES_USER=manga
# openssl rand -hex 24
POSTGRES_PASSWORD=REMPLACER_MOI
# Doit reprendre exactement l'utilisateur, le mot de passe et la base
# ci-dessus. L'hôte reste `database` : c'est le nom du service compose.
DATABASE_URL="postgresql://manga:REMPLACER_MOI@database:5432/manga_stream?serverVersion=16&charset=utf8"

# ---------------------------------------------------------------------------
# Symfony
# ---------------------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0
# openssl rand -hex 32
APP_SECRET=REMPLACER_MOI

# Expression régulière des origines autorisées. Les points doivent être
# échappés — « exemple.tld » non échappé accepterait aussi « exempleXtld ».
# Vérifier avec : docker compose exec backend printenv CORS_ALLOW_ORIGIN
CORS_ALLOW_ORIGIN=^https://(www\.)?exemple\.tld$

# Base des URLs absolues générées hors requête HTTP (mails, Link header).
DEFAULT_URI=https://exemple.tld

# Les migrations restent manuelles. Un redéploiement ne doit jamais toucher
# au schéma sans décision explicite :
#   docker compose exec backend php bin/console doctrine:migrations:migrate
RUN_MIGRATIONS=0

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# openssl rand -hex 32. La paire RSA en est dérivée au premier démarrage :
# la changer après coup rend les clés existantes inutilisables.
JWT_PASSPHRASE=REMPLACER_MOI
JWT_TTL=3600
GENERATE_JWT_KEYS=1

# ---------------------------------------------------------------------------
# Mercure
# ---------------------------------------------------------------------------
# INTERNE : conteneur -> conteneur. Ne change pas entre dev et prod.
MERCURE_URL=http://mercure/.well-known/mercure
# PUBLIQUE : c'est l'URL que le NAVIGATEUR ouvrira. En https, sur le domaine
# réel. Y laisser localhost:3000 donne un symptôme trompeur — l'application
# fonctionne, les publications côté serveur partent bien, et aucune
# notification n'arrive jamais chez le visiteur.
MERCURE_PUBLIC_URL=https://exemple.tld/.well-known/mercure
# openssl rand -hex 32
MERCURE_JWT_SECRET=REMPLACER_MOI
MERCURE_CORS_ORIGINS=https://exemple.tld
MERCURE_PUBLISH_ORIGINS=https://exemple.tld
# Non négociable : à `true`, n'importe quel navigateur pourrait s'abonner aux
# notifications de n'importe quel compte.
MERCURE_ALLOW_ANONYMOUS=false
MERCURE_DEMO_UI=false
MERCURE_SUBSCRIPTIONS=true

# ---------------------------------------------------------------------------
# Frontend — VARIABLES FIGÉES AU BUILD
#
# Vite remplace textuellement les `import.meta.env.VITE_*` par leur valeur au
# moment du `npm run build`. Après quoi elles n'existent plus : elles sont
# écrites en dur dans le JavaScript téléchargé par le visiteur. Les changer
# ici sans RECONSTRUIRE l'image ne produit strictement aucun effet.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#       build --no-cache frontend
#
# VITE_API_URL est relatif : même origine que la page, donc aucun CORS côté
# navigateur, et l'image survit à un changement de domaine.
# VITE_MERCURE_URL doit être absolu — EventSource n'accepte pas partout une
# URL relative.
# ---------------------------------------------------------------------------
VITE_API_URL=/api
VITE_MERCURE_URL=https://exemple.tld/.well-known/mercure
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# E-mail
#
# Mailpit ne tourne PAS en production (profil `dev-uniquement`). Il faut un
# vrai relais. Quelques formes de DSN acceptées par symfony/mailer :
#
#   smtp://utilisateur:motdepasse@smtp.exemple.net:587
#   brevo+api://CLE_API@default
#   ses+api://ACCESS_KEY:SECRET_KEY@default?region=eu-west-3
#
# Un mot de passe SMTP contenant @ / : / # doit être encodé en pourcentage.
# ---------------------------------------------------------------------------
MAILER_DSN=smtp://utilisateur:motdepasse@smtp.exemple.net:587
MAILER_FROM=no-reply@exemple.tld

# ---------------------------------------------------------------------------
# Sauvegardes
# ---------------------------------------------------------------------------
# Répertoire SUR L'HÔTE. Un chemin hôte et non un volume nommé, pour que les
# dumps soient directement copiables hors-site (rsync, restic, rclone) sans
# passer par `docker cp`.
BACKUP_HOST_DIR=/srv/manga-stream/backups
# 86400 = un dump par jour.
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=14
# Délai avant le premier dump après un démarrage : évite un dump à chaque
# redéploiement.
BACKUP_STARTUP_DELAY=300

# ---------------------------------------------------------------------------
# Synchronisation AniList
# ---------------------------------------------------------------------------
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_SYNC_ENABLED=true
ANILIST_SYNC_INTERVAL=86400

# ---------------------------------------------------------------------------
# Messenger
# ---------------------------------------------------------------------------
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MESSENGER_CONSUME_TRANSPORTS=async
MESSENGER_TIME_LIMIT=3600
MESSENGER_MEMORY_LIMIT=128M
MESSENGER_RETRY_DELAY=15

# Construction des images : l'utilisateur applicatif du conteneur.
UID=1000
GID=1000
NPM_INSTALL_FLAGS=
