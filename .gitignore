# ===========================================================================
# manga-stream :: root gitignore
# Per-folder rules also live in backend/.gitignore and frontend/.gitignore.
# ===========================================================================

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example
!/backend/.env
!/backend/.env.dev
!/backend/.env.test

# Clés et certificats, où qu'ils soient. Le dépôt est PUBLIC : une clé privée
# publiée permettrait de forger un JWT pour n'importe quel compte. La CI
# vérifie en plus qu'aucun .pem n'est suivi par git.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub

# ---------------------------------------------------------------------------
# PHP / Symfony (backend)
# ---------------------------------------------------------------------------
/backend/vendor/
/backend/var/
/backend/.env.local
/backend/.env.local.php
/backend/.env.*.local
/backend/config/jwt/
/backend/config/secrets/prod/prod.decrypt.private.php
/backend/public/bundles/
/backend/.phpunit.result.cache
# PHPUnit 10+ : cacheDirectory de backend/phpunit.dist.xml
/backend/.phpunit.cache/
/backend/.php-cs-fixer.cache
/backend/.phpstan.cache/
/backend/phpstan.neon
/backend/phpunit.xml
/backend/composer.phar

# ---------------------------------------------------------------------------
# Node / Vite (frontend)
# ---------------------------------------------------------------------------
node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/.vite/
/frontend/coverage/
/frontend/*.local
/frontend/vite.config.ts.timestamp-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------------------------------------------------------------------------
# Logs & runtime
# ---------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml
/infra/**/*.local.conf
/.docker/
/data/

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# IDE / editors
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.iml
*.swp
*.swo
*~
.fleet/
.nova/
.history/

# ---------------------------------------------------------------------------
# Explicitly TRACKED (shared contracts — do not ignore)
#   docs/openapi.yaml is the backend <-> frontend contract.
# ---------------------------------------------------------------------------
!docs/
!docs/**
